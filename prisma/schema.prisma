generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Diet {
  omnivore
  vegetarian
  vegan
}

model Guest {
  id             String   @id @default(cuid())
  name           String
  diet           Diet
  meaningful     Boolean
  plusOne        String
  rsvp           Boolean? // null = undecided; only rsvp=true guests appear in the constellation
  note           String? // optional message the guest left when RSVPing, either way
  isChildUnder2  Boolean  @default(false)
  needsHighChair Boolean  @default(false)
  registeredById String? // set on family rows: the primary registrant who added them
  registeredBy   Guest?   @relation("GuestFamilyParty", fields: [registeredById], references: [id], onDelete: SetNull)
  familyMembers  Guest[]  @relation("GuestFamilyParty")
  inviteeId      String? // set when the RSVP arrived through a tokenized invite link
  invitee        Invitee? @relation(fields: [inviteeId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
}

// The dishes on offer at the reception, edited on /admin. Diet is the same
// three-way scale as a guest's, so a guest's diet reads directly against the
// menu: a vegan can eat the vegan dishes, a vegetarian those and the
// vegetarian ones, an omnivore anything.
model MenuOption {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  diet        Diet
  createdAt   DateTime @default(now())
}

// Site-wide key/value settings: defaultInvitationHtml, the invitation letter
// used for every invitee without a personal one, plus invitationEmailSubject
// and invitationEmailBodyHtml, the invitation email's own text.
model Setting {
  key   String @id
  value String
}

// Invite-list entries, seeded from the gitignored guestlist.json via
// scripts/seed-invitees.mjs (emails must never live in the public repo).
model Invitee {
  id               String    @id @default(cuid())
  side             String // 'both' | 'elizabeth' | 'ray'
  name             String
  email            String?
  note             String?
  diagramHovertext String? // shown on hover over this person's name in the tapestry
  sortOrder        Int
  inviteToken      String?   @unique // non-guessable token for /invite/[token]
  invitationHtml   String? // host-authored invitation letter (TipTap HTML)
  invitationSentAt DateTime? // set only when a host explicitly sends the invite email
  guests           Guest[]

  @@unique([side, name])
}
